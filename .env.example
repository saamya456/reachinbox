# ---------- Backend ----------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
# 32-byte base64 key for encrypting SMTP passwords / Slack tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ---------- Auth / OAuth ----------
# Frontend origin (post-login redirects; allowed Origin for state-changing API calls).
APP_URL=http://localhost:5173
# Google OAuth client (Google Cloud Console -> Credentials -> OAuth client ID, type 'Web application').
# Authorized redirect URI must equal GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
# Slack app (api.slack.com/apps -> OAuth & Permissions). Redirect URL must equal SLACK_REDIRECT_URI.
# Slack requires HTTPS redirect URLs: expose the backend through an HTTPS tunnel in development.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/slack/callback
# Comma-separated emails allowed to open the BullMQ dashboard at /admin/queues.
ADMIN_EMAILS=

# ---------- PostgreSQL ----------
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox
POSTGRES_DB=reachinbox
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Number of email jobs one worker process handles in parallel (BullMQ worker concurrency).
WORKER_CONCURRENCY=5
# Minimum gap (ms) between two sends from the same sender, across all workers.
# A campaign's own delay_between_emails_ms applies when it is larger.
MIN_SEND_DELAY_MS=2000
# Global cap of emails per sender per hour (on top of each sender's own hourly limit). Empty = no global cap.
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# ---------- Elasticsearch ----------
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200
# Alias of the email search index (physical index: <alias>-v1).
ELASTICSEARCH_EMAIL_INDEX=reachinbox-emails
# Optional credentials (not needed for the local container).
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ES_JAVA_OPTS=-Xms512m -Xmx512m

# ---------- Frontend ----------
VITE_API_URL=http://localhost:4000
